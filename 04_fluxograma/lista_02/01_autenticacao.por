programa
{
	
	funcao inicio()
	{
		cadeia email, senha
	
		escreva("Digite o e-mail: ")
   		leia(email)
   		escreva("Digite a senha: ")
   		leia(senha)

   		se ((email == "financeiro@email.com") e (senha == "123456Senha@")){
      		escreva("Deixa a vida me levar, vida leva eu!\n")
      		escreva("Sou feliz e agradeço por tudo que Deus me deu!")
   		}senao{
      		escreva("Infelizmente você não pode acessar esse conteúdo")
   		}
	}
}

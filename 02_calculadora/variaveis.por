programa {
  funcao inicio() {
    inteiro numero = 10
    real numeroReal = 12.5
    caracter opcao = 'a' 
    logico status = verdadeiro
    cadeia frase = "A Turma 06 é TOP!"

    // Exibir os dados das variáveis na tela
    escreva(numero)
    escreva("\n" + numeroReal)
    escreva("\n" + opcao)
    escreva("\n" + status)
    escreva("\n" + frase)
  }
}
